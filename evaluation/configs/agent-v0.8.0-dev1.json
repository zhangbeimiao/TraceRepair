{
  "agent_version": "0.8.0-dev1",
  "parent_agent_version": "0.7.0-dev2",
  "status": "development_only_not_benchmarked",
  "architecture": "langgraph_end_to_end",
  "durable_state": "sqlite_only",
  "langgraph_checkpointer": false,
  "model": "qwen3.8-flash",
  "planner_protocol": "native_function_calling",
  "planner": {
    "max_completion_tokens": 800,
    "max_calls_per_task": 5,
    "max_total_completion_tokens": 3072,
    "tool_choice": "required",
    "parallel_tool_calls": false
  },
  "prompt_registry": {
    "source": "src/tracerepair/prompt_registry.py",
    "stages": ["diagnosis", "patch_generation", "patch_review"],
    "persist_prompt_sha256": true,
    "untrusted_repository_delimiters": true
  },
  "function_contract": {
    "model_visible": ["repo_map", "search_code", "read_file", "propose_patch", "handoff"],
    "controller_only": ["apply_patch", "run_tests", "run_regression"],
    "stage_allowlist": true,
    "argument_validation": true,
    "schema_sha256_persisted": true,
    "execution_authority": false
  },
  "semantic_review": {
    "allowed_outputs": ["propose_patch", "handoff"],
    "tool_access": false,
    "file_write_access": false,
    "shell_access": false,
    "test_access": false,
    "execution_authority": false
  },
  "workflow": {
    "max_diagnosis_turns": 3,
    "max_patch_attempts": 1,
    "semantic_review_attempts": 1,
    "final_success_state": "awaiting_review"
  },
  "verification": [
    "patch_policy",
    "target_test",
    "regression_test",
    "human_review"
  ],
  "frozen_predecessor_unchanged": {
    "agent_version": "0.7.0-dev2",
    "blind_benchmark": "langgraph-blind-six-repository-v0.7.0-dev2",
    "result": "2/6 pass@1; 4 safe handoffs; 0 incorrect accepted patches"
  },
  "evaluation_rule": "only known development tasks may tune this version; any locked evaluation requires a new pre-sealed benchmark"
}
